{
    "name": "imagina/imagina-growth-connector",
    "description": "Puente liviano entre WordPress/WooCommerce e Imagina Growth.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "opis/json-schema": "^2.4",
        "phpunit/phpunit": "^9.6",
        "wp-coding-standards/wpcs": "^3.1",
        "wp-phpunit/wp-phpunit": "^7.1",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "ImaginaGrowth\\Connector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ImaginaGrowth\\Connector\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.99"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:wp": "phpunit -c phpunit-wp.xml.dist",
        "lint": "phpcs"
    }
}
