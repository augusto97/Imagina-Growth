{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growth.imagina.cloud/schemas/events/lead.created.json",
  "title": "lead.created",
  "description": "Generado en el hub: un formulario, un chat (WhatsApp, Messenger o Instagram, desde la v7), una cotización, una cita, el panel, la API, una página de captura del hub o un formulario de anuncios de Meta o de Google (desde la v8) creó un lead.",
  "type": "object",
  "required": [
    "lead_id",
    "origin",
    "score",
    "temperature"
  ],
  "properties": {
    "lead_id": {
      "type": "string",
      "maxLength": 40
    },
    "origin": {
      "enum": [
        "form",
        "whatsapp",
        "messenger",
        "instagram",
        "quote",
        "booking",
        "manual",
        "api",
        "landing",
        "meta_lead_ads",
        "google_lead_form"
      ]
    },
    "service": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "temperature": {
      "enum": [
        "cold",
        "warm",
        "hot"
      ]
    },
    "channel": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 32
    },
    "form_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "value": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?\\d{1,15}(\\.\\d{1,2})?$"
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "lead_id": "ld_01JE",
      "origin": "form",
      "service": "Asesoría laboral",
      "score": 55,
      "temperature": "warm",
      "channel": "paid_search",
      "form_id": "cf7:12",
      "value": null,
      "currency": null
    },
    {
      "lead_id": "ld_01JF",
      "origin": "instagram",
      "service": null,
      "score": 15,
      "temperature": "cold",
      "channel": "instagram",
      "form_id": null,
      "value": null,
      "currency": null
    },
    {
      "lead_id": "ld_01JG",
      "origin": "landing",
      "service": "Limpieza dental",
      "score": 20,
      "temperature": "cold",
      "channel": "direct",
      "form_id": "landing:lp_01JG",
      "value": null,
      "currency": null
    },
    {
      "lead_id": "ld_01JH",
      "origin": "meta_lead_ads",
      "service": null,
      "score": 20,
      "temperature": "cold",
      "channel": "paid_meta",
      "form_id": "meta:1234567890",
      "value": null,
      "currency": null
    },
    {
      "lead_id": "ld_01JJ",
      "origin": "google_lead_form",
      "service": null,
      "score": 20,
      "temperature": "cold",
      "channel": "paid_google",
      "form_id": "google:40000000001",
      "value": null,
      "currency": null
    }
  ],
  "x-invalid-examples": [
    {
      "lead_id": "ld_01JE",
      "origin": "fax",
      "score": 10,
      "temperature": "warm"
    },
    {
      "lead_id": "ld_01JE",
      "origin": "lead_ads",
      "score": 10,
      "temperature": "warm"
    }
  ]
}
