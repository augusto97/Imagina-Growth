{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growth.imagina.cloud/schemas/events/customer.updated.json",
  "title": "customer.updated",
  "description": "Esquema de `properties` del evento customer.updated (docs/eventos.md §4)",
  "type": "object",
  "required": [
    "customer_ref"
  ],
  "properties": {
    "customer_ref": {
      "type": "string",
      "pattern": "^[a-z]+:[A-Za-z0-9_-]{1,64}$"
    },
    "first_name": {
      "type": "string",
      "maxLength": 120
    },
    "last_name": {
      "type": "string",
      "maxLength": 120
    },
    "email": {
      "anyOf": [
        {
          "$ref": "_defs.json#/$defs/email"
        },
        {
          "const": ""
        }
      ]
    },
    "phone": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 32
    },
    "marketing_optin": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "billing": {
      "$ref": "_defs.json#/$defs/address"
    },
    "registered_at": {
      "$ref": "_defs.json#/$defs/datetime_or_null"
    },
    "locale": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      },
      "maxItems": 50
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "customer_ref": "wc:77",
      "changed": [
        "billing.city"
      ],
      "billing": {
        "city": "Pereira"
      }
    }
  ],
  "x-invalid-examples": [
    {
      "customer_ref": "wc:77",
      "password": "x"
    }
  ]
}
