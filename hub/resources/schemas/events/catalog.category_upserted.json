{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growth.imagina.cloud/schemas/events/catalog.category_upserted.json",
  "title": "catalog.category_upserted",
  "description": "Esquema de `properties` del evento catalog.category_upserted (docs/eventos.md §4)",
  "type": "object",
  "required": [
    "category_id",
    "name"
  ],
  "properties": {
    "category_id": {
      "$ref": "_defs.json#/$defs/external_id"
    },
    "parent_id": {
      "$ref": "_defs.json#/$defs/external_id_or_null"
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "slug": {
      "type": "string",
      "maxLength": 200
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{16,64}$",
      "description": "Hash del contenido que calcula el origen; el hub lo devuelve en /v1/s/catalog/hashes"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "category_id": "12",
      "parent_id": null,
      "name": "Pinturas",
      "slug": "pinturas",
      "hash": "4f1c2a7b3d4e5f6071829304a5b6c7d8"
    },
    {
      "category_id": "13",
      "name": "Brochas"
    }
  ],
  "x-invalid-examples": [
    {
      "category_id": "12"
    },
    {
      "category_id": "12",
      "name": "Pinturas",
      "hash": "no-hex"
    }
  ]
}
