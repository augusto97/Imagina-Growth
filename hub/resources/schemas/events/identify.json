{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growth.imagina.cloud/schemas/events/identify.json",
  "title": "identify",
  "description": "Esquema de `properties` del evento identify (docs/eventos.md §4)",
  "type": "object",
  "required": [
    "method"
  ],
  "properties": {
    "method": {
      "type": "string",
      "enum": [
        "login",
        "link_token",
        "form"
      ]
    },
    "token": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^[A-Za-z0-9_-]+\\.[0-9a-f]{64}$",
      "description": "Token firmado por el sitio (window.igrUser.token, api-connector.md §7). Sin token válido, el hub no vincula al visitante con el cliente."
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "method": "login"
    },
    {
      "method": "login",
      "token": "eyJyZWYiOiJ3Yzo3NyJ9.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    }
  ],
  "x-invalid-examples": [
    {
      "method": "magic"
    },
    {
      "method": "login",
      "token": "sin-firma"
    }
  ]
}
