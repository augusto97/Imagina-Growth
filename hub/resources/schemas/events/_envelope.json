{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growth.imagina.cloud/schemas/events/_envelope.json",
  "title": "Sobre del evento (docs/eventos.md §2)",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event",
    "occurred_at",
    "source",
    "identity",
    "properties"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "description": "Versión del contrato (eventos.md §8). Cada versión solo agrega eventos o campos opcionales; el hub acepta todas."
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event": {
      "type": "string",
      "pattern": "^([a-z_]+\\.[a-z_]+|custom\\.[a-z0-9_]{1,48}|identify)$"
    },
    "occurred_at": {
      "$ref": "_defs.json#/$defs/datetime"
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "platform",
        "site_id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "browser",
            "server",
            "hub",
            "import"
          ]
        },
        "platform": {
          "type": "string",
          "enum": [
            "woocommerce",
            "wordpress",
            "hub"
          ]
        },
        "site_id": {
          "type": "string",
          "pattern": "^st_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "sdk": {
          "type": "string",
          "pattern": "^(connector|tracker|hub)/[0-9A-Za-z.+-]{1,32}$"
        }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "anonymous_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "customer_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z]+:[A-Za-z0-9_-]{1,64}$"
        },
        "email": {
          "anyOf": [
            {
              "$ref": "_defs.json#/$defs/email"
            },
            {
              "type": "null"
            }
          ]
        },
        "phone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32,
          "description": "E.164 si el origen lo pudo normalizar; si no, el hub lo normaliza"
        },
        "link_token": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "page": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 2048
            },
            "path": {
              "type": "string",
              "maxLength": 2048
            },
            "title": {
              "type": "string",
              "maxLength": 500
            },
            "referrer": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "additionalProperties": false
        },
        "page_type": {
          "type": "string",
          "enum": [
            "home",
            "product",
            "category",
            "cart",
            "checkout",
            "thankyou",
            "search",
            "account",
            "blog",
            "landing",
            "other"
          ]
        },
        "utm": {
          "$ref": "_defs.json#/$defs/utm"
        },
        "click_ids": {
          "$ref": "_defs.json#/$defs/click_ids"
        },
        "ad_cookies": {
          "type": "object",
          "properties": {
            "fbp": {
              "type": "string",
              "maxLength": 500
            },
            "fbc": {
              "type": "string",
              "maxLength": 500
            },
            "ga_client_id": {
              "type": "string",
              "maxLength": 500
            },
            "ttp": {
              "type": "string",
              "maxLength": 500
            }
          },
          "additionalProperties": false
        },
        "first_touch": {
          "$ref": "_defs.json#/$defs/touch"
        },
        "last_touch": {
          "$ref": "_defs.json#/$defs/touch"
        },
        "device": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "mobile",
                "tablet",
                "desktop"
              ]
            },
            "os": {
              "type": "string",
              "maxLength": 64
            },
            "browser": {
              "type": "string",
              "maxLength": 64
            }
          },
          "additionalProperties": false
        },
        "consent": {
          "type": "object",
          "properties": {
            "analytics": {
              "type": "boolean"
            },
            "marketing": {
              "type": "boolean"
            },
            "source": {
              "type": "string",
              "maxLength": 40
            }
          },
          "additionalProperties": false
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2}([-_][A-Za-z]{2})?$"
        },
        "currency": {
          "$ref": "_defs.json#/$defs/currency"
        },
        "ip": {
          "type": "string",
          "maxLength": 45,
          "description": "Solo en tránsito: el hub deriva el geo y la descarta"
        },
        "user_agent": {
          "type": "string",
          "maxLength": 1024,
          "description": "Solo en tránsito"
        },
        "referral_code": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9_-]{3,32}$",
          "description": "v4: ?ref= de la URL de aterrizaje (referidos y afiliados, M14)."
        }
      },
      "additionalProperties": false
    },
    "properties": {
      "type": "object"
    },
    "encrypted": {
      "type": "object",
      "description": "Obsoleto desde la v6 (no lo envía nadie; se acepta por compatibilidad). checkout.contact_captured viaja firmado por /v1/s con el dato en identity.",
      "properties": {
        "alg": {
          "type": "string",
          "maxLength": 32
        },
        "data": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "type": {
                "const": "browser"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "identity": {
            "properties": {
              "email": {
                "type": "null"
              },
              "phone": {
                "type": "null"
              }
            }
          }
        }
      },
      "description": "Los eventos de navegador nunca traen correo ni teléfono (eventos.md §2)"
    }
  ]
}
