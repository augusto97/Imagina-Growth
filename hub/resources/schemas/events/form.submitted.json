{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growth.imagina.cloud/schemas/events/form.submitted.json",
  "title": "form.submitted",
  "description": "Esquema de `properties` del evento form.submitted (docs/eventos.md §4)",
  "type": "object",
  "required": [
    "form_plugin",
    "form_id",
    "fields"
  ],
  "properties": {
    "form_plugin": {
      "type": "string",
      "maxLength": 40
    },
    "form_id": {
      "type": "string",
      "maxLength": 64
    },
    "form_name": {
      "type": "string",
      "maxLength": 200
    },
    "fields": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 300
        },
        "phone": {
          "type": "string",
          "maxLength": 300
        },
        "first_name": {
          "type": "string",
          "maxLength": 300
        },
        "last_name": {
          "type": "string",
          "maxLength": 300
        },
        "company": {
          "type": "string",
          "maxLength": 300
        },
        "city": {
          "type": "string",
          "maxLength": 300
        },
        "message": {
          "type": "string",
          "maxLength": 5000
        },
        "service": {
          "type": "string",
          "maxLength": 300
        },
        "budget": {
          "type": "string",
          "maxLength": 300
        }
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "maxProperties": 60,
      "not": {
        "anyOf": [
          {
            "required": [
              "password"
            ]
          },
          {
            "required": [
              "card_number"
            ]
          }
        ]
      }
    },
    "page_path": {
      "type": "string",
      "maxLength": 2048
    },
    "consents": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "form_plugin": "cf7",
      "form_id": "12",
      "form_name": "Contacto",
      "fields": {
        "email": "ana@ejemplo.com",
        "phone": "3001234567",
        "first_name": "Ana",
        "message": "Quiero una cotización"
      },
      "page_path": "/contacto/",
      "consents": {
        "email_marketing": false
      }
    }
  ],
  "x-invalid-examples": [
    {
      "form_plugin": "cf7",
      "form_id": "12",
      "fields": {
        "password": "secreto"
      }
    }
  ]
}
