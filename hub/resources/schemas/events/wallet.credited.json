{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growth.imagina.cloud/schemas/events/wallet.credited.json",
  "title": "wallet.credited",
  "description": "Generado en el hub: se acreditó saldo a favor (cashback, devolución, canje de puntos, ajuste).",
  "type": "object",
  "required": [
    "ledger_id",
    "amount",
    "currency",
    "reason"
  ],
  "properties": {
    "ledger_id": {
      "type": "string",
      "maxLength": 40
    },
    "amount": {
      "$ref": "_defs.json#/$defs/money"
    },
    "currency": {
      "$ref": "_defs.json#/$defs/currency"
    },
    "balance_after": {
      "$ref": "_defs.json#/$defs/money"
    },
    "reason": {
      "type": "string",
      "maxLength": 40,
      "description": "order, review, review_media, referral, signup, birthday, profile, campaign, manual, redeem, expiry, refund…"
    },
    "ref_type": {
      "type": "string",
      "maxLength": 20
    },
    "ref_id": {
      "type": "string",
      "maxLength": 60
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "ledger_id": "lg_01JG",
      "amount": "20000.00",
      "currency": "COP",
      "balance_after": "35000.00",
      "reason": "refund",
      "ref_type": "order",
      "ref_id": "1234"
    }
  ],
  "x-invalid-examples": [
    {
      "ledger_id": "lg_01JG",
      "amount": "veinte",
      "currency": "COP",
      "reason": "order"
    }
  ]
}
