<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-text padding="8px 0" />
      <mj-section background-color="#ffffff" />
    </mj-attributes>
    <mj-style>.igr-legal a { color: #6b7280; }</mj-style>
  </mj-head>
  <mj-body background-color="#f3f4f6" width="600px">
    <mj-section padding="24px 24px 8px">
      <mj-column>
        <mj-text align="center" font-size="20px" font-weight="700" color="#111827">{% if tienda.logo != "" %}<img src="{{ tienda.logo }}" alt="{{ tienda.nombre }}" height="40" style="height:40px;width:auto;border:0;display:inline-block">{% else %}{{ tienda.nombre }}{% endif %}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="8px 24px 0">
      <mj-column>
        <mj-text font-size="24px" line-height="32px" font-weight="700" color="#111827">[[headline]]</mj-text>
        <mj-text font-size="16px" line-height="24px" color="#111827">[[intro]]</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="8px 24px">
      <mj-column border="1px solid #e5e7eb" border-radius="8px">
        <mj-image src="{{ producto.imagen }}" alt="{{ producto.nombre }}" href="{{ producto.url }}" padding="16px 16px 0" border-radius="6px" />
        <mj-text align="center" font-size="18px" font-weight="600" color="#111827">{{ producto.nombre }}</mj-text>
        <mj-text align="center" font-size="16px" color="#111827">{% if producto.precio_anterior != "" and producto.precio_anterior != producto.precio %}<s style="color:#6b7280">{{ producto.precio_anterior | moneda }}</s> {% endif %}<strong>{{ producto.precio | moneda }}</strong></mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="8px 24px 0">
      <mj-column>
        <mj-text font-size="18px" font-weight="700" color="#111827">[[products_title]]</mj-text>
        <mj-text font-size="14px" line-height="20px" color="#111827"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>{% for p in recomendaciones.para_ti limit: 3 %}<td width="33%" style="padding:0 6px;vertical-align:top;text-align:center"><a href="{{ p.url }}" style="color:#111827;text-decoration:none">{% if p.imagen != "" %}<img src="{{ p.imagen }}" alt="" width="160" style="width:100%;max-width:160px;border-radius:6px;display:block;margin:0 auto 8px">{% endif %}<span style="font-weight:600">{{ p.nombre }}</span><br><span>{{ p.precio | moneda }}</span></a></td>{% endfor %}</tr></table></mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="8px 24px 16px">
      <mj-column>
        <mj-button href="[[cta_url]]" background-color="#111827" color="#ffffff" font-size="16px" font-weight="600" border-radius="8px" inner-padding="14px 28px">[[cta]]</mj-button>
      </mj-column>
    </mj-section>
    <mj-section padding="24px 24px 32px">
      <mj-column>
        <mj-divider border-color="#e5e7eb" border-width="1px" padding="0 0 16px" />
        <mj-text css-class="igr-legal" align="center" font-size="12px" line-height="18px" color="#6b7280">Recibes este correo porque aceptaste recibir novedades de {{ tienda.nombre }}.<br>{{ tienda.nombre }}{% if tienda.direccion != "" %} · {{ tienda.direccion }}{% endif %}{% if tienda.contacto != "" %} · {{ tienda.contacto }}{% endif %}<br><a href="{{ enlaces.preferencias }}" style="color:#6b7280">Preferencias</a> · <a href="{{ enlaces.baja }}" style="color:#6b7280">Darte de baja</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
