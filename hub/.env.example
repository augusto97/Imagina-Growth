APP_NAME="Imagina Growth"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

IGR_APP_URL="${APP_URL}"
IGR_INGEST_URL="${APP_URL}"
# Genera con: php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
IGR_BLIND_INDEX_KEY=
IGR_REQUIRE_2FA=true
IGR_INGEST_SHARDS=4

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=igr
DB_USERNAME=igr
DB_PASSWORD=igr

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=igr
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,localhost:5173

# Tiempo real (Reverb, hub/CLAUDE.md §13). Con «log» no hay tiempo real y la bandeja consulta cada 5 s.
# Producción: BROADCAST_CONNECTION=reverb y las llaves (php artisan reverb:install las genera).
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Lo que ve el navegador: en producción la SPA lo recibe en tiempo de ejecución (window.igrRuntime) desde estas
# variables (vacío = el host de APP_URL, 443 y https). En desarrollo, `npm run dev` también acepta VITE_REVERB_*.
IGR_REVERB_PUBLIC_HOST=
IGR_REVERB_PUBLIC_PORT=443
IGR_REVERB_PUBLIC_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Caché en otra instancia de Redis (producción: 6380 con allkeys-lru). Vacío = la misma de arriba.
REDIS_CACHE_HOST=
REDIS_CACHE_PORT=

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hola@growth.imagina.cloud"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Predicciones (Fase 4): servicio hub/ml (en producción, growth-ml en 127.0.0.1:8095).
IGR_ML_URL=http://127.0.0.1:8095
IGR_ML_TOKEN=

# IA (Fase 4, config/igr-ai.php): clave propia del hub; sin ella la IA queda apagada.
IGR_ANTHROPIC_API_KEY=
IGR_AI_MONTHLY_BUDGET_USD=25

# Notificaciones push de la bandeja (php artisan igr:push:vapid)
IGR_PUSH_VAPID_PUBLIC_KEY=
IGR_PUSH_VAPID_PRIVATE_KEY=

# Agenda (Fase 5, config/igr-bookings.php): Google Calendar opcional y paso entre horarios.
# IGR_GOOGLE_CALENDAR_CLIENT_ID=
# IGR_GOOGLE_CALENDAR_CLIENT_SECRET=
# IGR_GOOGLE_CALENDAR_REDIRECT=   # por defecto {APP_URL}/p/_google/calendar/callback
# IGR_BOOKING_STEP_MIN=15

# API pública y webhooks (Fase 5, config/igr.php).
# IGR_API_PER_MINUTE=120                 # si el plan no fija api_requests_per_minute
# IGR_WEBHOOKS_PAUSE_AFTER_FAILURES=15
# IGR_WEBHOOKS_ALLOW_PRIVATE_URLS=       # vacío: solo en local y pruebas

# Dominios propios de las agencias (Fase 5): CNAME al que apuntan.
# IGR_CUSTOM_DOMAINS_CNAME=domains.growth.imagina.cloud

# Actualización desde el panel de la plataforma (docs/despliegue.md §5, config/growth.php). Solo sirven para
# mostrar la versión nueva: growth-update descarga con /etc/growth/updater.conf y verifica la firma.
# GROWTH_STATE_PATH=/opt/growth/shared/state   # en desarrollo, p. ej. storage/app/growth-state
# GROWTH_UPDATE_REPO=augusto97/Imagina-Growth
# GROWTH_UPDATE_API=https://api.github.com

# Vigilancia (docs/despliegue.md §6): heartbeats de Better Stack de `growth:monitor` (vacíos = sin aviso).
BETTERSTACK_HEARTBEAT_HEALTH=
BETTERSTACK_HEARTBEAT_STREAMS=
BETTERSTACK_HEARTBEAT_QUEUES=
GROWTH_MONITOR_MAX_STREAM_LAG=5000
GROWTH_MONITOR_MAX_STREAM_AGE=120
GROWTH_MONITOR_MAX_QUEUE_BACKLOG=10000
