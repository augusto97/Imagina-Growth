APP_NAME="Imagina Growth"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

IGR_APP_URL="${APP_URL}"
IGR_INGEST_URL="${APP_URL}"
# Genera con: php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
IGR_BLIND_INDEX_KEY=
IGR_REQUIRE_2FA=true
IGR_INGEST_SHARDS=4

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=igr
DB_USERNAME=igr
DB_PASSWORD=igr

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=igr
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,localhost:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hola@growth.imagina.cloud"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Predicciones (Fase 4): servicio hub/ml (docker compose: http://ml:8095).
IGR_ML_URL=http://127.0.0.1:8095
IGR_ML_TOKEN=
