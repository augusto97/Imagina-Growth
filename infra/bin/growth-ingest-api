#!/usr/bin/env bash
# Réplica N de la ingesta: FrankenPHP en 127.0.0.1:(8080 + N). La arranca growth-ingest-api@N.service.
set -euo pipefail
n=${1:?falta el número de réplica}
[[ $n =~ ^[1-9][0-9]?$ ]] || { echo "Réplica inválida: $n" >&2; exit 2; }
exec "$(cd "$(dirname "$0")" && pwd)/growth-web" $((8080 + n))
