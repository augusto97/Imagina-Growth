# FrankenPHP de cada proceso web del hub (growth-app y growth-ingest-api@N). Escucha solo en la máquina;
# delante está el Caddy del sistema (/etc/caddy/Caddyfile), que pone el TLS. El puerto llega en GROWTH_PORT.
{
	admin off
	auto_https off
	persist_config off
	frankenphp {
		# Hilos de PHP del proceso (bin/growth-web: 2 en servidores pequeños, el doble de CPU si no).
		num_threads {$GROWTH_PHP_THREADS:4}
	}
	servers {
		trusted_proxies static 127.0.0.1/32 ::1/128
	}
	log {
		output stderr
		level WARN
	}
}

http://:{$GROWTH_PORT} {
	bind 127.0.0.1
	root * /opt/growth/current/hub/public
	# Los archivos del build llevan el hash en el nombre: un año en caché y sin revalidar (docs/rendimiento.md §4).
	# Solo si el archivo existe: el 404 de un hash viejo (pestaña abierta durante una actualización) no se guarda.
	@build_assets {
		path /build/assets/*
		file
	}
	header @build_assets Cache-Control "public, max-age=31536000, immutable"
	php_server
}
