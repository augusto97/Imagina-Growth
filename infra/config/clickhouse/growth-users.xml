<!-- Usuarios de ClickHouse (/etc/clickhouse-server/users.d/growth-users.xml). Lo genera infra/bin/growth-system
     (al instalar y en cada actualización):
     __IGR_SHA256__ y __DEFAULT_SHA256__ son el sha256 de las contraseñas (nunca van en claro).
     - igr: el de la app (CLICKHOUSE_PASSWORD del .env); también hace las copias y la prueba de restauración.
       Sin administración de usuarios ni de colecciones con nombre: la app no las usa (auditoría S13).
     - default: con contraseña aleatoria y solo desde la máquina (no lo usa nadie). -->
<clickhouse>
    <users>
        <default>
            <password remove="1"/>
            <password_sha256_hex>__DEFAULT_SHA256__</password_sha256_hex>
            <networks replace="replace">
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>
        </default>
        <igr>
            <password_sha256_hex>__IGR_SHA256__</password_sha256_hex>
            <networks>
                <ip>127.0.0.1</ip>
                <ip>::1</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
        </igr>
    </users>
</clickhouse>
