<!-- Disco local para BACKUP de ClickHouse; las copias nocturnas (infra/backup) lo suben al Storage Box. -->
<clickhouse>
    <storage_configuration>
        <disks>
            <backups>
                <type>local</type>
                <path>/var/lib/growth-backups/clickhouse/</path>
            </backups>
        </disks>
    </storage_configuration>
    <backups>
        <allowed_disk>backups</allowed_disk>
        <allowed_path>/var/lib/growth-backups/clickhouse/</allowed_path>
    </backups>
</clickhouse>
