    { "name": "BETTERSTACK_HEARTBEAT_QUEUES", "default": "", "secret": false },
    { "name": "GROWTH_MONITOR_MAX_STREAM_LAG", "default": "5000", "secret": false },
    { "name": "GROWTH_MONITOR_MAX_STREAM_AGE", "default": "120", "secret": false },
    { "name": "GROWTH_MONITOR_MAX_QUEUE_BACKLOG", "default": "10000", "secret": false },

    { "name": "GROWTH_UPDATE_REPO", "default": "augusto97/Imagina-Growth", "secret": false },
    { "name": "GROWTH_UPDATE_API", "default": "https://api.github.com", "secret": false },
    { "name": "GROWTH_STATE_PATH", "default": "/opt/growth/shared/state", "secret": false }
  ]
