    { "name": "IGR_PUSH_VAPID_PUBLIC_KEY", "default": null, "secret": true, "format": "vapid_public", "never_regenerate": true },
    { "name": "IGR_PUSH_VAPID_PRIVATE_KEY", "default": null, "secret": true, "format": "vapid_private", "never_regenerate": true },

    { "name": "IGR_META_APP_ID", "default": null, "secret": false },
