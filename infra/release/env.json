    { "name": "LOG_DAILY_DAYS", "default": "14", "secret": false },
    { "name": "BCRYPT_ROUNDS", "default": "12", "secret": false },

    { "name": "DB_CONNECTION", "default": "mariadb", "secret": false },
    { "name": "DB_HOST", "default": "127.0.0.1", "secret": false },
    { "name": "DB_PORT", "default": "3306", "secret": false },
    { "name": "DB_DATABASE", "default": "igr", "secret": false },
    { "name": "DB_USERNAME", "default": "igr", "secret": false },
    { "name": "DB_PASSWORD", "default": null, "secret": true, "format": "alnum_32", "never_regenerate": true },

