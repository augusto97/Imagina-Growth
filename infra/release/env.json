    { "name": "REVERB_SERVER_PORT", "default": "8085", "secret": false },
    { "name": "REVERB_HOST", "default": "127.0.0.1", "secret": false },
    { "name": "REVERB_PORT", "default": "8085", "secret": false },
    { "name": "REVERB_SCHEME", "default": "http", "secret": false },
    { "name": "IGR_REVERB_PUBLIC_HOST", "default": "", "secret": false },
    { "name": "IGR_REVERB_PUBLIC_PORT", "default": "443", "secret": false },
    { "name": "IGR_REVERB_PUBLIC_SCHEME", "default": "https", "secret": false },

    { "name": "MAIL_MAILER", "default": "log", "secret": false },
    { "name": "MAIL_FROM_ADDRESS", "default": "hola@growth.imagina.cloud", "secret": false },
    { "name": "MAIL_FROM_NAME", "default": "${APP_NAME}", "secret": false },
    { "name": "AWS_ACCESS_KEY_ID", "default": null, "secret": true, "format": "none" },
    { "name": "AWS_SECRET_ACCESS_KEY", "default": null, "secret": true, "format": "none" },
    { "name": "AWS_DEFAULT_REGION", "default": "us-east-1", "secret": false },

    { "name": "IGR_ML_URL", "default": "http://127.0.0.1:8095", "secret": false },
    { "name": "IGR_ML_TOKEN", "default": null, "secret": true, "format": "hex_32" },

    { "name": "IGR_ANTHROPIC_API_KEY", "default": null, "secret": true, "format": "none" },
