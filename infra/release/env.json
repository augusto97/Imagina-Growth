    { "name": "REDIS_CLIENT", "default": "phpredis", "secret": false },
    { "name": "REDIS_HOST", "default": "127.0.0.1", "secret": false },
    { "name": "REDIS_PORT", "default": "6379", "secret": false },
    { "name": "REDIS_PASSWORD", "default": null, "secret": true, "format": "alnum_32", "never_regenerate": true },
    { "name": "REDIS_DB", "default": "0", "secret": false },
    { "name": "REDIS_INGEST_DB", "default": "2", "secret": false },
    { "name": "REDIS_CACHE_HOST", "default": "127.0.0.1", "secret": false },
    { "name": "REDIS_CACHE_PORT", "default": "6380", "secret": false },
    { "name": "REDIS_CACHE_PASSWORD", "default": null, "secret": true, "format": "alnum_32", "never_regenerate": true },
