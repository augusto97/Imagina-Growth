{
  "$comment": "Variables de entorno que necesita cada versión del hub (docs/despliegue.md §3). build.sh las copia a release.json. El actualizador agrega las que falten en shared/.env con su valor por defecto, sin pisar las que ya existen. secret=true: se genera según format solo si falta; never_regenerate=true: si falta en una instalación existente, la actualización se detiene (los datos ya guardados dependen de ese valor). format=none: secreto que pone el administrador (queda vacío si falta). ${VAR} se resuelve con el mismo .env (dotenv).",
  "variables": [
    { "name": "APP_NAME", "default": "Imagina Growth", "secret": false },
    { "name": "APP_ENV", "default": "production", "secret": false },
    { "name": "APP_KEY", "default": null, "secret": true, "format": "laravel_key", "never_regenerate": true },
    { "name": "APP_DEBUG", "default": "false", "secret": false },
    { "name": "APP_URL", "default": "https://growth.imagina.cloud", "secret": false },
    { "name": "APP_LOCALE", "default": "es", "secret": false },
    { "name": "APP_FALLBACK_LOCALE", "default": "es", "secret": false },
    { "name": "APP_FAKER_LOCALE", "default": "es_CO", "secret": false },

    { "name": "IGR_APP_URL", "default": "${APP_URL}", "secret": false },
    { "name": "IGR_INGEST_URL", "default": "${APP_URL}", "secret": false },
    { "name": "IGR_LINKS_URL", "default": "${APP_URL}", "secret": false },
    { "name": "IGR_BLIND_INDEX_KEY", "default": null, "secret": true, "format": "laravel_key", "never_regenerate": true },
    { "name": "IGR_REQUIRE_2FA", "default": "true", "secret": false },
    { "name": "IGR_INGEST_SHARDS", "default": "4", "secret": false },
    { "name": "IGR_CUSTOM_DOMAINS_CNAME", "default": "domains.growth.imagina.cloud", "secret": false },

    { "name": "LOG_CHANNEL", "default": "stack", "secret": false },
