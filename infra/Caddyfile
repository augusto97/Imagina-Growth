# Borde del hub (hub/CLAUDE.md §18). Cloudflare va delante del panel; la
# ingesta y los dominios de seguimiento de los clientes llegan directo.
{
	email {$IGR_ACME_EMAIL}
	# TLS bajo demanda solo para dominios que pertenecen a un sitio conectado
	# (sites.tracking_domain y dominios propios de enlaces y preferencias).
	on_demand_tls {
		ask http://app:8080/internal/caddy/ask
	}
}

(common) {
	# Las rutas internas (p. ej. el «ask» de TLS) nunca se exponen hacia afuera.
	@internal path /internal/*
	respond @internal 404
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output stdout
		format json
		# Nunca se registran IPs completas ni cuerpos (CLAUDE.md §3.9).
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 16 32
				request>client_ip ip_mask 16 32
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Igr-Signature delete
			}
		}
	}
}

growth.imagina.cloud {
	import common
	# WebSockets de Reverb (bandeja en tiempo real): /app/{key} y la API HTTP /apps/{id}.
	@reverb path /app/* /apps/*
	reverse_proxy @reverb reverb:8080
	reverse_proxy app:8080
}

in.growth.imagina.cloud {
	import common
	@ingest path /v1/* /p/*
	reverse_proxy @ingest ingest:8080
	respond 404
}

go.growth.imagina.cloud {
	import common
	reverse_proxy app:8080
}

# Dominios de los clientes: t.cliente.com (seguimiento), enlaces, centro de preferencias, página de
# reservas y el panel de marca blanca de una agencia (M22). El «ask» solo autoriza dominios verificados.
https:// {
	import common
	tls {
		on_demand
	}
	@ingest path /v1/* /p/*
	reverse_proxy @ingest ingest:8080
	# Panel de marca blanca: la bandeja en tiempo real también necesita Reverb.
	@reverb path /app/* /apps/*
	reverse_proxy @reverb reverb:8080
	reverse_proxy app:8080
}
