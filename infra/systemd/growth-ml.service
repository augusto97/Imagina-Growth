# Servicio de predicciones (hub/ml, uvicorn en 127.0.0.1:8095 con el entorno de uv de la versión).
[Unit]
Description=Imagina Growth · predicciones (ML)
After=network-online.target mariadb.service clickhouse-server.service redis-server@queue.service redis-server@cache.service
Wants=network-online.target
PartOf=growth.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
# Lo primero que se sacrifica si falta memoria: las predicciones se recalculan en la próxima corrida.
OOMScoreAdjust=500
Type=exec
WorkingDirectory=/opt/growth/current/hub/ml
ExecStart=/opt/growth/current/bin/growth-ml
TimeoutStopSec=30
User=growth
Group=growth
Restart=always
RestartSec=2
# Endurecimiento: el código es de solo lectura; solo se escribe en shared/ (storage, estado, caché).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/growth/shared
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LimitNOFILE=65535
SyslogIdentifier=%N

[Install]
WantedBy=growth.target
