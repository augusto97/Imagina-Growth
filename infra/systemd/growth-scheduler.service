# tareas programadas
[Unit]
Description=Imagina Growth · tareas programadas
After=network-online.target mariadb.service clickhouse-server.service redis-server@queue.service redis-server@cache.service
Wants=network-online.target
PartOf=growth.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=exec
ExecStart=/usr/local/bin/growth-php /opt/growth/current/hub/artisan schedule:work
KillSignal=SIGTERM
TimeoutStopSec=120
User=growth
Group=growth
WorkingDirectory=/opt/growth/current/hub
Restart=always
RestartSec=2
# Endurecimiento: el código es de solo lectura; solo se escribe en shared/ (storage, estado, caché).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/growth/shared
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LimitNOFILE=65535
SyslogIdentifier=%N

[Install]
WantedBy=growth.target
