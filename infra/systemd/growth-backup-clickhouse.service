# Copia diaria (docs/despliegue.md §6). Corre como root: lee /etc/growth/backup.conf y el .env de la app con un
# lector dotenv propio (nunca con source ni EnvironmentFile), y sube con rclone (config. en /root/.config/rclone).
[Unit]
Description=Imagina Growth · copia de ClickHouse (BACKUP nativo, completa o incremental) al Storage Box
After=network-online.target clickhouse-server.service
Wants=network-online.target

[Service]
Type=oneshot
# Los scripts se instalan como root en /usr/local/lib/growth/backup (no se corren desde /opt/growth/current,
# que el usuario growth puede escribir).
ExecStart=/usr/local/lib/growth/backup/growth-backup-clickhouse
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
SyslogIdentifier=%N
