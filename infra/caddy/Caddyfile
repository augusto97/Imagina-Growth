# Borde del hub de Imagina Growth (/etc/caddy/Caddyfile). Lo escribe infra/install.sh y lo mantiene al día
# growth-system en cada actualización (__DOMAIN__, __EMAIL_LINE__ y __TRUSTED_PROXIES__ se reemplazan), mientras
# nadie lo edite a mano: si se editó, la versión nueva queda en Caddyfile.growth.new y el actual no se toca.
# docs/despliegue.md §1 y §7.
{
	__EMAIL_LINE__
	# Detrás de Cloudflare la IP del visitante llega en CF-Connecting-IP; solo se cree si la petición viene de una IP
	# de Cloudflare (rangos de cloudflare.com/ips, renovados por growth-system). Sin Cloudflare no cambia nada.
	servers {
		trusted_proxies static __TRUSTED_PROXIES__
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
	# TLS bajo demanda solo para dominios que pertenecen a un sitio conectado
	# (dominio de seguimiento, enlaces, centro de preferencias, reservas y panel de marca blanca).
	on_demand_tls {
		ask http://127.0.0.1:8080/internal/caddy/ask
	}
}

(common) {
	# Las rutas internas (p. ej. el «ask» de TLS) nunca se exponen hacia afuera.
	@internal path /internal/*
	respond @internal 404
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output stdout
		# JSON (wrap json) y nunca IPs completas, cuerpos, cookies ni tokens (CLAUDE.md §3.9): la consulta se borra
		# entera (códigos de OAuth, carritos, correos del restablecimiento) y los tokens de las rutas públicas
		# (baja, preferencias, reseñas, invitaciones, restablecer, enlaces /c/) quedan como ***.
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 16 32
				request>client_ip ip_mask 16 32
				request>uri regexp "(/(?:u|preferencias|r/nps|r|invitacion|restablecer|c)/)[^/?]+|(\?).*" "$1$2***"
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>X-Igr-Signature delete
				request>headers>X-Igr-Health-Token delete
				request>headers>Cf-Connecting-Ip delete
				request>headers>X-Forwarded-For delete
				request>headers>True-Client-Ip delete
				request>headers>Referer delete
				resp_headers>Set-Cookie delete
				resp_headers>Location delete
			}
		}
	}
}

# Panel, API y SPA (growth-app). Si el proceso se está reiniciando, Caddy reintenta hasta 15 s en vez de fallar.
# X-Forwarded-For lleva solo la IP ya resuelta del visitante: la app confía únicamente en Caddy (127.0.0.1).
(app) {
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-For {client_ip}
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

# Ingesta: dos réplicas (growth-ingest-api@1 y @2). Se reinician de a una y Caddy usa la que esté arriba.
# El chequeo usa /up (vivo) y no /health/ready: la ingesta solo escribe en Redis y no debe rechazar eventos
# porque ClickHouse tarde en responder.
(ingest) {
	reverse_proxy 127.0.0.1:8081 127.0.0.1:8082 {
		header_up X-Forwarded-For {client_ip}
		lb_policy round_robin
		lb_try_duration 15s
		lb_try_interval 250ms
		health_uri /up
		health_interval 5s
		health_timeout 3s
		fail_duration 10s
	}
}

# Tiempo real (Reverb): WebSockets /app/{key} y API HTTP /apps/{id}.
(reverb) {
	@reverb path /app/* /apps/*
	handle @reverb {
		reverse_proxy 127.0.0.1:8085 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}

# Todo en un solo dominio: panel, API y SPA (growth-app), ingesta de los sitios (/v1 y /p, a las réplicas de
# ingesta) y enlaces rastreados, baja y preferencias. No hace falta ningún otro registro DNS. Para separar la ingesta
# o los enlaces en subdominios: el registro DNS, un bloque igual a este con ese nombre y IGR_INGEST_URL o IGR_LINKS_URL.
__DOMAIN__ {
	import common
	import reverb
	@ingest path /v1/* /p/*
	handle @ingest {
		import ingest
	}
	handle {
		import app
	}
}

# Dominios de los clientes: t.cliente.com (seguimiento), enlaces, centro de preferencias, página de
# reservas y el panel de marca blanca de una agencia (M22). El «ask» solo autoriza dominios verificados.
https:// {
	import common
	tls {
		on_demand
	}
	import reverb
	@ingest path /v1/* /p/*
	handle @ingest {
		import ingest
	}
	handle {
		import app
	}
}
